# IndicWrite AI Configuration
# Multilingual Hinglish Smart Writing Assistant

# Gemini API (Supporting LLM)
# Obtain your key at https://aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# BharatGen Param1 Configuration (Primary Writing Improvement Provider)
# Model reference: https://huggingface.co/bharatgenai
BHARATGEN_API_KEY=""
BHARATGEN_MODEL_ENDPOINT=""

# AI4Bharat Integrations (Transliteration & Translation)
# IndicXlit repository: https://github.com/AI4Bharat/IndianNLP-Transliteration
AI4BHARAT_INDICXLIT_ENDPOINT=""
# IndicTrans2 repository: https://github.com/AI4Bharat/IndicTrans2
AI4BHARAT_INDICTRANS2_ENDPOINT=""

# Application Runtime Ports
APP_ENV="development"
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_URL="MY_APP_URL"

# Local FAISS Vector Database & Multilingual Embeddings
FAISS_INDEX_PATH="storage/faiss/index.faiss"
FAISS_METADATA_PATH="storage/faiss/metadata.json"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
